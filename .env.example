PORT=8080

# Required. All business pages/APIs require this key.
UIPM_ACCESS_KEY=change-this-key
# true only when served over HTTPS
UIPM_COOKIE_SECURE=false

# Host persistence path for Docker Compose. Default: ./data
UIPM_HOST_DATA_DIR=./data

# Alibaba Cloud OSS. Endpoint URLs are derived from the region.
UIPM_S3_PROVIDER=oss
UIPM_S3_BUCKET=uipm
UIPM_S3_REGION=cn-chengdu
UIPM_S3_ACCESS_KEY_ID=
UIPM_S3_SECRET_ACCESS_KEY=

# Bucket-bound HTTPS domain. Required for direct OSS reads and HTML preview.
# This is only a DNS/OSS binding, not another application service.
UIPM_OSS_CNAME=

# Optional advanced settings
# UIPM_S3_ENDPOINT_URL=https://oss-cn-chengdu-internal.aliyuncs.com
# UIPM_S3_PREFIX=uipm
# UIPM_S3_PRESIGN_TTL_SECONDS=3600
